# Copiez ce fichier vers `.env` pour le développement local.
# `.env` est ignoré par Git ; ne committez jamais vos vraies valeurs.
#
# Longueurs minimales imposées par l'API :
# - ADMIN_PASSWORD : 11 caractères minimum (mot de passe de connexion au studio)
# - SESSION_SECRET : 32 caractères minimum (signature des sessions)
# - PLUGIN_TOKEN   : 24 caractères minimum (accès du plugin PMMP)

ADMIN_PASSWORD=choisissez-un-mot-de-passe-de-11-caracteres-minimum
SESSION_SECRET=remplacez-par-une-chaine-aleatoire-de-32-caracteres-minimum
PLUGIN_TOKEN=remplacez-par-un-jeton-aleatoire-de-24-caracteres-minimum
